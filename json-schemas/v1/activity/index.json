{
	"title": "Activity Schema",
	"type": "object",
	"properties": {
		"parentId": {
			"type": "string"
		},
		"id": {
			"type": "string"
		},
		"activityType": {
			"title": "Activity Type",
			"type": "string",
			"tsEnumNames": [
				"VISIT",
				"WAIT",
				"UNACCOUNTABLE_TIME"
			],
			"enum": [
				"visit",
				"wait",
				"unaccountable time"
			]
		},
		"testStationName": {
			"type": "string",
			"minLength": 1,
			"pattern": ".*\\S.*"
		},
		"testStationPNumber": {
			"type": "string",
			"minLength": 1,
			"pattern": ".*\\S.*"
		},
		"testStationEmail": {
			"type": "string"
		},
		"testStationType": {
			"title": "Test Station Types",
			"type": "string",
			"tsEnumNames": [
				"ATF",
				"GVTS",
				"HQ",
				"POTF",
				"VEF"
			],
			"enum": [
				"atf",
				"gvts",
				"hq",
				"potf",
				"vef"
			]
		},
		"testerName": {
			"type": "string",
			"pattern": ".*\\S.*",
			"minLength": 1,
			"maxLength": 60
		},
		"testerStaffId": {
			"type": "string",
			"minLength": 1,
			"pattern": ".*\\S.*"
		},
		"testerEmail": {
			"type": "string",
			"format": "email",
			"if": {
				"properties": {
					"activityType": {
						"const": "visit"
					}
				}
			},
			"then": {
				"type": "string",
				"format": "email"
			},
			"else": {
				"not": {}
			}
		},
		"startTime": {
			"type": "string",
			"minLength": 1,
			"pattern": ".*\\S.*"
		},
		"endTime": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"pattern": ".*\\S.*"
				},
				{
					"type": "null"
				}
			]
		},
		"waitReason": {
			"type": "array",
			"items": {
				"title": "Wait Reason",
				"type": "string",
				"tsEnumNames": [
					"WAITING_FOR_VEHICLE",
					"BREAK",
					"ADMIN",
					"SITE_ISSUE",
					"OTHER"
				],
				"enum": [
					"Waiting for vehicle",
					"Break",
					"Admin",
					"Site issue",
					"Other"
				]
			}
		},
		"notes": {
			"oneOf": [
				{
					"type": "string",
					"pattern": ".*\\S.*"
				},
				{
					"type": "null"
				}
			]
		},
		"activityDay": {
			"type": "string"
		}
	},
	"additionalProperties": false,
	"required": [
		"activityType",
		"testStationName",
		"testStationPNumber",
		"testStationEmail",
		"testStationType",
		"testerName",
		"testerStaffId",
		"startTime"
	]
}