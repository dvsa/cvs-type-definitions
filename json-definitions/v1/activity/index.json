{
  "title": "Activity Schema",
  "type": "object",
  "properties": {
    "parentId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "activityType": {
      "$ref": "../enums/activityType.enum.json"
    },
    "testStationName": {
      "type": "string"
    },
    "testStationPNumber": {
      "type": "string"
    },
    "testStationEmail": {
      "type": "string",
      "format": "email"
    },
    "testStationType": {
      "$ref": "../enums/testStationType.enum.json"
    },
    "testerName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "testerStaffId": {
      "type": "string"
    },
    "testerEmail": {
      "type": "string",
      "format": "email",
      "if": {
        "properties": {
          "activityType": {
            "const": "visit"
          }
        }
      },
      "then": {
        "type": "string",
        "format": "email"
      },
      "else": {
        "not": {}
      }
    },
    "startTime": {
      "type": "string"
    },
    "endTime": {
      "type": ["null", "string"]
    },
    "waitReason": {
      "type": "array",
      "items": {
        "$ref": "../enums/waitReason.enum.json"
      }
    },
    "notes": {
      "type": "string"
    },
    "activityDay": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "activityType",
    "testStationName",
    "testStationPNumber",
    "testStationEmail",
    "testStationType",
    "testerName",
    "testerStaffId",
    "startTime"
  ]
}
